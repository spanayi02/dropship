# ─────────────────────────────────────────────────────────────────────────────
# WishlistAZ — environment
# Copy to .env (never commit .env). Every variable the app reads is listed
# here; the supplier section is explained step by step in README.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dropship_db?schema=public"
NEXTAUTH_SECRET="change-me-to-a-random-string-of-at-least-32-characters"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="WishlistAZ"

# Store currency (ISO 4217). Prices in the database are minor units of this
# currency. Supplier quotes in other currencies are converted with FX_* below.
NEXT_PUBLIC_CURRENCY="EUR"
# Storefront shipping promise, in minor units (4.90 € flat, free from 50 €).
NEXT_PUBLIC_FLAT_SHIPPING_RATE="490"
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="5000"

# ── Auth (optional Google sign-in) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Payments ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Stripe → Developers → Webhooks → endpoint https://<domain>/api/webhooks/stripe
# Events: checkout.session.completed, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
FROM_EMAIL="WishlistAZ <hello@wishlistaz.com>"

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/*.
# Any other scheduler must do the same. Generate with: openssl rand -hex 32
CRON_SECRET=""
# Shared key for POST /api/suppliers/update-prices (header x-api-key), the
# endpoint a spreadsheet script or a B2B supplier's feed can push prices to.
PRICE_UPDATE_API_KEY=""

# ── Supplier FX rates ───────────────────────────────────────────────────────
# CJ, Alibaba and Made-in-China quote in USD. Rates are deliberately static:
# set them, and review them when you review supplier prices. FX_<FROM>_<TO>.
FX_USD_EUR="0.92"
# FX_CNY_EUR="0.13"

# ── CJ Dropshipping (API supplier: search, live prices, auto-order, tracking) ─
# API key: My CJ → Apps → Install "API" → Apps → API → Add API (type "API Key").
# You can paste the same key in Admin → Suppliers instead of setting it here;
# the admin value wins when both exist. Tokens are cached in the database.
CJ_API_KEY=""
# openId is returned by the first token fetch and stored on the supplier row.
# Set it here only if you registered the webhook before the first API call
# (it is the HMAC secret CJ signs webhook pushes with).
CJ_OPEN_ID=""
# Alternative webhook auth: register the URL as
#   https://<domain>/api/webhooks/cj?secret=<CJ_WEBHOOK_SECRET>
CJ_WEBHOOK_SECRET=""
# Warehouse CJ ships from when a supplier/listing does not pin one (CN, DE, US…).
# Set the supplier's "Ships from" in the admin per warehouse instead if you use several.
CJ_FROM_COUNTRY="CN"
# Destination used for shipping quotes during import and price sync.
CJ_QUOTE_COUNTRY="CY"
# Force one carrier (CJ "logisticName", e.g. "CJPacket Ordinary"). Empty = cheapest
# option returned by CJ's freight calculator for each order.
CJ_LOGISTIC_NAME=""
# "true": pay orders from the CJ wallet balance immediately (payType 2).
# "false": create the order only; you pay it in My CJ → Orders (payType 3).
CJ_AUTO_PAY="false"
# "true": every order is a sandbox order (no charge, no fulfilment). Use while testing.
CJ_SANDBOX="true"
# EU VAT for non-EU warehouses: 1 = no IOSS, 2 = your own IOSS number, 3 = CJ's IOSS.
CJ_IOSS_TYPE=""
CJ_IOSS_NUMBER=""
# Label CJ shows as the order source. Leave as is.
CJ_PLATFORM="Api"
# Advanced: min ms between CJ calls (free accounts: 1 req/s) and request timeout.
# CJ_MIN_INTERVAL_MS="1100"
# CJ_TIMEOUT_MS="25000"

# ── AliExpress ───────────────────────────────────────────────────────────────
# No variables yet. AliExpress is a manual supplier until the Dropshipping API
# (https://openservice.aliexpress.com) is approved for your account. See README.

# ── Alibaba / Made-in-China ─────────────────────────────────────────────────
# No variables: these are B2B suppliers without a dropship API. Quotes, MOQ and
# lead time live on each product listing (admin or CSV import). See README.
